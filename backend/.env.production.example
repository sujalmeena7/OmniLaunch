# OmniLaunch Backend — Production Environment Variables
# Copy this to your deployment environment (AWS Parameter Store, Secrets Manager, etc.)

# App
DEBUG=false

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Redis (AWS ElastiCache)
REDIS_URL=redis://your-elasticache-endpoint:6379/0

# JWT — Generate a strong random secret: openssl rand -hex 32
JWT_SECRET=your-strong-random-secret-here

# Razorpay (Billing) — LIVE MODE keys
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your-live-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
RAZORPAY_PLAN_ID_PRO_MONTHLY=plan_XXXXXXXXXXXXXXX
RAZORPAY_PLAN_ID_PRO_YEARLY=plan_XXXXXXXXXXXXXXX
RAZORPAY_PLAN_ID_TEAM_MONTHLY=plan_XXXXXXXXXXXXXXX
RAZORPAY_PLAN_ID_TEAM_YEARLY=plan_XXXXXXXXXXXXXXX

# CORS — Your production frontend domain
CORS_ORIGINS=["https://your-domain.com"]
